# Installed as /etc/footbath/remote-debug.env by install_remote_debug.sh.
# This file contains no password, private key, Tailscale key, or router credential.

FOOTBATH_WS=/home/sky/rk3576_footbath_ws
FOOTBATH_SERVICE=footbath-mobile.service
FOOTBATH_DEBUG_DIR=/home/sky/footbath_debug
FOOTBATH_TUNING_DIR=/home/sky/footbath_tuning
FOOTBATH_CHASSIS_DEBUG_PORT=/dev/footbath_chassis_debug
FOOTBATH_ROUTER_IP=192.168.8.1
FOOTBATH_LAN_IP=192.168.8.10
FOOTBATH_EXPOSE_ROS_DDS=0
# The installer changes this to 1 only with --enable-motion-tools. A separate
# root-owned short arm lease is still required before every motion session.
FOOTBATH_ALLOW_REMOTE_MOTION=0
ROS_DISTRO=humble
ROS_DOMAIN_ID=0
