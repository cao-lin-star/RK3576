FOOTBATH_WS=/home/sky/rk3576_footbath_ws
FOOTBATH_MOBILE_BIND=0.0.0.0
FOOTBATH_MOBILE_PORT=8080
FOOTBATH_MOBILE_NETWORK=192.168.8.
FOOTBATH_MAPPING_SCAN_SOURCE=fused
FOOTBATH_MOBILE_PIN_SALT=REPLACE_ME
