<!-- Compute once and execute. Terminal failures are handled by frontier selection;
     near-obstacle cancellation/confirmation belongs exclusively to supervisor. -->
<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <Sequence name="ExploreCommittedPath">
      <RecoveryNode number_of_retries="1" name="ComputeExplorePath">
        <ComputePathToPose goal="{goal}" path="{path}" planner_id="GridBased"/>
        <ClearEntireCostmap name="ClearGlobalCostmap-Context" service_name="global_costmap/clear_entirely_global_costmap"/>
      </RecoveryNode>
      <FollowPath path="{path}" controller_id="ExplorePath" goal_checker_id="exploration_goal_checker"/>
    </Sequence>
  </BehaviorTree>
</root>
