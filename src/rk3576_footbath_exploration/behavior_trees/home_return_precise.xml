<!-- Return-only staging: same bounded recovery policy, explicit precise plugins.
     DockMotion still verifies <= 4 cm before independent heading alignment.
     This BT is used only after switching to saved-map navigation. -->
<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode number_of_retries="1" name="HomeNavigateRecovery">
      <PipelineSequence name="HomeNavigateWithReplanning">
        <RateController hz="1.0">
          <RecoveryNode number_of_retries="1" name="ComputeHomePath">
            <ComputePathToPose goal="{goal}" path="{path}" planner_id="GridBased"/>
            <ClearEntireCostmap name="ClearGlobalCostmap-Context" service_name="global_costmap/clear_entirely_global_costmap"/>
          </RecoveryNode>
        </RateController>
        <RecoveryNode number_of_retries="1" name="FollowHomePath">
          <FollowPath path="{path}" controller_id="ReturnPath" goal_checker_id="return_goal_checker"/>
          <ClearEntireCostmap name="ClearLocalCostmap-Context" service_name="local_costmap/clear_entirely_local_costmap"/>
        </RecoveryNode>
      </PipelineSequence>
      <ReactiveFallback name="HomeRecoveryFallback">
        <GoalUpdated/>
        <RoundRobin name="BoundedHomeRecoveries">
          <Sequence name="ClearBothCostmaps">
            <ClearEntireCostmap name="ClearLocalCostmap" service_name="local_costmap/clear_entirely_local_costmap"/>
            <ClearEntireCostmap name="ClearGlobalCostmap" service_name="global_costmap/clear_entirely_global_costmap"/>
          </Sequence>
          <Wait wait_duration="2.0"/>
          <BackUp backup_dist="0.10" backup_speed="0.05"/>
        </RoundRobin>
      </ReactiveFallback>
    </RecoveryNode>
  </BehaviorTree>
</root>
